# ─── PromptForge Environment Variables ───────────────────────────────────────
#
# Copy this file to .env for local development.
# On Render, set these in the "Environment" tab of your Web Service.
#
# DO NOT commit your real .env file — it is already in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Server ──────────────────────────────────────────────────────────────────

# Port the Express server listens on.
# Render sets this automatically — do NOT override it in Render's env panel.
PORT=10000

# Node environment — must be "production" on Render.
NODE_ENV=production

# Your Render public URL — used for sitemap generation and CORS.
# Example: https://prompt-forge.onrender.com
# No trailing slash.
PUBLIC_URL=https://your-service-name.onrender.com

# ─── Supabase ────────────────────────────────────────────────────────────────

# Found in: Supabase Dashboard → Project Settings → API

# Your Supabase project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Anon/public key — safe to expose to the browser (used in frontend auth.js)
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Service role key — NEVER expose this to the browser.
# Used only by the backend (server/config/supabase.js).
# Treat this like a database password.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ─── Optional ────────────────────────────────────────────────────────────────

# JWT secret — only needed if you add custom JWT signing beyond Supabase auth.
# Leave blank unless you implement your own token signing.
# JWT_SECRET=
